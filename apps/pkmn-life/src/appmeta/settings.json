    "sprint_display": {
      "label": "Sprint",
      "description": "How the clock shows the sprint: not at all, a bar of work days along the bottom, a dot per work day, or the days left in short (S22 | 6 left).",
      "type": "enum",
      "default": "short",
      "options": [
        {
          "value": "none",
          "label": "Not shown"
        },
        {
          "value": "bar",
          "label": "Sprint bar"
        },
        {
          "value": "dots",
          "label": "Sprint dots"
        },
        {
          "value": "short",
          "label": "Days left"
        }
      ]
    },
    "clock_animation": {
      "label": "Clock animation",
      "description": "Plays over the clock on work days, and when the app starts, whatever the sprint display. Majora's Mask: 'Dawn of the Nth Day', then '-N Days Remain-', at dawn; all day adds 'Meal of the Nth Day' and 'Dusk of the Nth Day'. Hold START to see the one for now.",
      "type": "enum",
      "default": "majora_day",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "majora",
          "label": "Majora's Mask: dawn"
        },
        {
          "value": "majora_day",
          "label": "Majora's Mask: all day"
        }
      ]
    },
    "dawn_time": {
      "label": "Dawn time",
      "type": "time",
      "default": "09:00"
    },
    "meal_time": {
      "label": "Meal time",
      "type": "time",
      "default": "12:00"
    },
    "dusk_time": {
      "label": "Dusk time",
      "type": "time",
      "default": "17:00"
    },
    "sprint_changes": {
      "label": "Sprint changes",
      "description": "Exceptions to the two-week sprints, separated by commas. 26=2026-12-17 moves sprint 26's start (the one before runs until then); add /3w to make it 3 weeks; 26/3w only changes its length; 30+/3w makes sprint 30 and every later one 3 weeks; off=2026-12-24..2027-01-01 marks days off. Everything else is worked out.",
      "type": "string",
      "default": "",
      "max_length": 500
    },
    "remote_control": {
      "label": "Mac remote",
      "description": "Let the Pkmn Life Remote Mac app play entries. The app checks for its requests once a second.",
      "type": "boolean",
      "default": true
    },
    "remote": {
      "label": "Remote request",
      "description": "Written by the Pkmn Life Remote Mac app. Leave it empty.",
      "type": "string",
      "default": "",
      "max_length": 120
    },
    "time_format": {
      "label": "Time format",
      "type": "enum",
      "default": "24h",
      "options": [
        {
          "value": "24h",
          "label": "24-hour"
        },
        {
          "value": "12h",
          "label": "12-hour"
        }
      ]
    },
    "show_date": {
      "label": "Show date",
      "description": "The calendar, and the date line under the time when the sprint isn't shown or is a sprint bar.",
      "type": "boolean",
      "default": true
    },
    "blink_colons": {
      "label": "Colon blink",
      "type": "boolean",
      "default": true
    }
  }
