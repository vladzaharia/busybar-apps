{
  "name": "pkmn-life",
  "private": true,
  "version": "0.1.0",
  "description": "Pkmn Life: team screens for the BUSY Bar: a sprint clock, a Jira nag, and redirects",
  "type": "module",
  "scripts": {
    "assets": "node assets/redirects.ts && node assets/build.ts",
    "typecheck": "pnpm assets && tsc && tsc -p assets",
    "build": "pnpm assets && busy-cli build --emit both",
    "app:install": "busy-cli app install",
    "app:uninstall": "busy-cli app uninstall",
    "app:run": "busy-cli app run",
    "app:stop": "busy-cli app stop",
    "sim": "node ../../packages/sim/scripts/build.ts . --out dist/sim",
    "sim:serve": "node ../../packages/sim/scripts/build.ts . --out dist/sim --serve"
  },
  "dependencies": {
    "@vladzaharia/bar-core": "workspace:*"
  },
  "devDependencies": {
    "@busy-app/cli": "0.6.0",
    "@types/node": "^22.19.4",
    "@vladzaharia/bar-pixel": "workspace:*",
    "typescript": "~6.0.3",
    "vite": "8.1.4",
    "@vladzaharia/bar-sim": "workspace:*"
  }
}
