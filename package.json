{
  "name": "busybar-apps",
  "private": true,
  "type": "module",
  "description": "On-device JavaScript apps for the BUSY Bar, and the shared libraries they are built from",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18 <26"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "new-app": "node scripts/new-app.ts"
  },
  "devDependencies": {
    "@types/node": "^22.19.4",
    "typescript": "~6.0.3"
  }
}
