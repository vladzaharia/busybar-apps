# Copy to .env (git-ignored) to tell pnpm bar which BUSY Bar to use. Without it, pnpm bar uses the bar on USB
# (10.0.4.20). Over Wi-Fi, turn on HTTP API access in the bar's web UI (Network -> HTTP API) first.
BUSY_BAR_ADDR=192.168.1.42
# Only with "Password protection" on. Quote it if it has a # in it (otherwise the rest is read as a comment):
# BUSY_BAR_PASSWORD="..."
